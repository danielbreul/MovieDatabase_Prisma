@page "/movies"
@inject IMovieService MovieService
@inject IGenreService GenreService
@inject IPersonService PersonService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Filme</PageTitle>

<Heading>Movies</Heading>

<Row>
    <Column ColumnSize="ColumnSize.IsAuto">
        <Button Color="Color.Primary" Clicked="CreateMovieAsync">
            <Icon Name="IconName.Add" />
            Neuer Film
        </Button>
    </Column>
    <Column>
        <Addons>
            <Addon AddonType="AddonType.Body">
                <TextEdit Placeholder="Nach Filmtitel suchen..." @bind-Text="searchText" KeyPress="OnSearchKeyPress" />
            </Addon>
            <Addon AddonType="AddonType.End">
                <Button Color="Color.Secondary" Clicked="PerformSearch">
                    Suche
                    <Icon Name="IconName.Search" />
                </Button>
            </Addon>
        </Addons>
    </Column>
</Row>

<Table Striped Hoverable>
    <TableHeader>
        <TableRow>
            <TableHeaderCell>Titel</TableHeaderCell>
            <TableHeaderCell TextAlignment="TextAlignment.Center">Löschen</TableHeaderCell>
        </TableRow>
    </TableHeader>
    <TableBody>
        @if (allMovies is not null)
        {
            if (allMovies.Any())
            {
                foreach (var movie in allMovies)
                {
                    <TableRow HoverCursor="Cursor.Pointer" Clicked='() => NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("id", movie.Id))'>
                        <TableRowCell>@movie.Title</TableRowCell>
                        <TableRowCell TextAlignment="TextAlignment.Center">
                            <Button Color="Color.Primary" Size="Size.Small" Clicked="@(() => DeleteMovie(movie))" @onclick:stopPropagation>
                                <Icon Name="IconName.Delete" />
                            </Button>
                        </TableRowCell>
                    </TableRow>
                }
            }
            else
            {
                <TableRow>
                    <TableRowCell ColumnSpan="2">Es sind keine Filme vorhanden.</TableRowCell>
                </TableRow>
            }
        }
        else
        {
            <TableRow>
                <TableRowCell ColumnSpan="2">Filme werden geladen ...</TableRowCell>
            </TableRow>
        }
    </TableBody>
</Table>

<Modal @ref="movieModal" Opening="OnMovieModalOpening" Closing="OnMovieModalClosing">
    <ModalContent Centered Size="ModalSize.ExtraLarge">
        <ModalHeader>
            <ModalTitle>
                @(movieModalMode == MovieModalMode.Create ? "Neuen Film erstellen"
                                : movieModalMode == MovieModalMode.Edit ? "Film bearbeiten"
                                : "Filmdetails")
            </ModalTitle>
            @if (movieModalMode == MovieModalMode.View)
            {
                <Button Margin="Margin.Is3.FromStart"
                        Color="Color.Primary"
                        Size="Size.Small"
                        Clicked="EditMovieAsync"
                        @onclick:stopPropagation>
                    <Icon Name="IconName.Edit" />
                    Bearbeiten
                </Button>
            }
        </ModalHeader>
        <ModalBody>
            @if (selectedMovie is not null)
            {
                if (movieModalMode == MovieModalMode.View)
                {
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Titel</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @selectedMovie.Title
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Handlung</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @* scrollable paragraph *@
                            <Paragraph Style="max-height:50px; overflow-y:auto; white-space: pre-line;">
                                @(selectedMovie.Plot is not null ? selectedMovie.Plot : "-")
                            </Paragraph>
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Erscheinungsdatum</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @(selectedMovie.ReleaseDate is not null ? selectedMovie.ReleaseDate?.ToString("dd.MM.yyyy") : "-")
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Bewertung</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            <Rating ReadOnly Color="Color.Primary" @bind-SelectedValue="@ratingValue" />
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Altersfreigabe</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @(selectedMovie.AgeRating is not null ? "FSK " + selectedMovie.AgeRating.ToString() : "-")
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Genre(s)</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @if (selectedMovie.Genres.Any())
                            {
                                @foreach (GenreViewModel genre in selectedMovie.Genres)
                                {
                                    <Badge Color="Color.Primary"
                                            Margin="Margin.Is1.FromEnd.Is1.FromBottom"
                                            Padding="Padding.Is2"
                                            TextWeight="TextWeight.Normal"
                                            TextSize="TextSize.Small"
                                            style="cursor: pointer;"
                                            @onclick="() => ShowRelatedMoviesModalAsync(genre.Id, genre.Name, RelationType.Genre)">
                                        @genre.Name
                                    </Badge>
                                }
                            }
                            else
                            {
                                @:-
                            }
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Regie</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @if (selectedMovie.Genres.Any())
                            {
                                @foreach (PersonViewModel person in selectedMovie.Directors)
                                {
                                    <Badge Color="Color.Primary"
                                           Margin="Margin.Is1.FromEnd.Is1.FromBottom"
                                           Padding="Padding.Is2"
                                           TextWeight="TextWeight.Normal"
                                           TextSize="TextSize.Small"
                                           style="cursor: pointer;"
                                           @onclick="() => ShowRelatedMoviesModalAsync(person.Id, person.Name, RelationType.Director)">
                                        @person.Name
                                    </Badge>
                                }
                            }
                            else
                            {
                                @:-
                            }
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Drehbuch</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @if (selectedMovie.Writer is not null)
                            {
                                <Badge Color="Color.Primary"
                                       Margin="Margin.Is1.FromEnd.Is1.FromBottom"
                                       Padding="Padding.Is2"
                                       TextWeight="TextWeight.Normal"
                                       TextSize="TextSize.Small"
                                       style="cursor: pointer;"
                                       @onclick="() => ShowRelatedMoviesModalAsync(selectedMovie.Writer.Id, selectedMovie.Writer.Name, RelationType.Writer)">
                                    @selectedMovie.Writer.Name
                                </Badge>
                            }
                            else
                            {
                                @:-
                            }
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Hauptdarsteller</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @if (selectedMovie.Genres.Any())
                            {
                                @foreach (PersonViewModel person in selectedMovie.Actors)
                                {
                                    <Badge Color="Color.Primary"
                                           Margin="Margin.Is1.FromEnd.Is1.FromBottom"
                                           Padding="Padding.Is2"
                                           TextWeight="TextWeight.Normal"
                                           TextSize="TextSize.Small"
                                           style="cursor: pointer;"
                                           @onclick="() => ShowRelatedMoviesModalAsync(person.Id, person.Name, RelationType.Actor)">
                                        @person.Name
                                    </Badge>
                                }
                            }
                            else
                            {
                                @:-
                            }
                        </Column>
                    </Row>
                    <Row Margin="Margin.Is2.OnY">
                        <Column ColumnSize="ColumnSize.Is4">
                            <strong>Laufzeit</strong>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is8">
                            @if (selectedMovie.Duration is not null)
                            {
                                @:@selectedMovie.Duration Minuten
                            }
                            else
                            {
                                @:-
                            }
                        </Column>
                    </Row>
                }
                else
                {
                    <Validations @ref="validations">
                        <Validation Validator="ValidationRule.IsNotEmpty">
                            <Field>
                                <FieldLabel RequiredIndicator>Titel</FieldLabel>
                                <FieldBody>
                                    <TextEdit @bind-Text="selectedMovie.Title">
                                        <Feedback>
                                            <ValidationError>Titel ist erforderlich.</ValidationError>
                                        </Feedback>
                                    </TextEdit>
                                </FieldBody>
                            </Field>
                        </Validation>
                        <Field>
                            <FieldLabel>Handlung</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.IsFull">
                                <MemoEdit AutoSize @bind-Text="selectedMovie.Plot" />
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Erscheinungsdatum</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                <DateEdit TValue="DateTime?" @bind-Date="selectedMovie.ReleaseDate" />
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Bewertung</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                <Rating Color="Color.Primary" @bind-SelectedValue="@ratingValue" />
                                @if (ratingValue > 0)
                                {
                                    <Button Color="Color.Light" Size="Size.Small" Clicked="() => selectedMovie.Rating = null" Margin="Margin.Is2.FromStart">
                                        <Icon Name="IconName.Clear" />
                                        Zurücksetzen
                                    </Button>
                                }
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Altersfreigabe</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                <Select TValue="int?" @bind-SelectedValue="selectedMovie.AgeRating">
                                    <SelectItem Value="(int?)null">Bitte wählen...</SelectItem>
                                    <SelectItem Value="0">FSK 0</SelectItem>
                                    <SelectItem Value="6">FSK 6</SelectItem>
                                    <SelectItem Value="12">FSK 12</SelectItem>
                                    <SelectItem Value="18">FSK 18</SelectItem>
                                </Select>
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Genre(s)</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                @foreach (GenreViewModel genre in selectedMovie.Genres)
                                {
                                    <Badge Color="Color.Primary"
                                           Margin="Margin.Is1.FromEnd.Is1.FromBottom"
                                           Padding="Padding.Is2"
                                           TextWeight="TextWeight.Normal"
                                           TextSize="TextSize.Small"
                                           CloseClicked="() => OnRemoveGenre(genre)">
                                        @genre.Name
                                    </Badge>
                                }
                                <Select TValue="int?" @bind-SelectedValue="addGenre">
                                    @if (availableGenres?.Any() ?? false)
                                    {
                                        <SelectItem Value="(int?)null">Genre hinzufügen...</SelectItem>
                                        @foreach (GenreViewModel genre in availableGenres)
                                        {
                                            <SelectItem Value="@genre.Id">@genre.Name</SelectItem>
                                        }
                                    }
                                    else
                                    {
                                        <SelectItem Value="(int?)null">Keine Genres verfügbar</SelectItem>
                                    }
                                </Select>
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Regie</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                @foreach (PersonViewModel person in selectedMovie.Directors)
                                {
                                    <Badge Color="Color.Primary"
                                            Margin="Margin.Is1.FromEnd.Is1.FromBottom"
                                            Padding="Padding.Is2"
                                            TextWeight="TextWeight.Normal"
                                            TextSize="TextSize.Small"
                                            CloseClicked="() => OnRemoveDirector(person)">
                                        @person.Name
                                    </Badge>
                                }
                                <Select TValue="int?" @bind-SelectedValue="addDirector">
                                    @if (availableDirectors?.Any() ?? false)
                                    {
                                        <SelectItem Value="(int?)null">Regie hinzufügen...</SelectItem>
                                        @foreach (PersonViewModel person in availableDirectors)
                                        {
                                            <SelectItem Value="@person.Id">@person.Name</SelectItem>
                                        }
                                    }
                                    else
                                    {
                                        <SelectItem Value="(int?)null">Keine Personen verfügbar</SelectItem>
                                    }
                                </Select>
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Drehbuch</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                <Select TValue="int?" @bind-SelectedValue="selectWriter">
                                    @if (allPersons?.Any() ?? false)
                                    {
                                        <SelectItem Value="(int?)null">Bitte wählen...</SelectItem>
                                        @foreach (PersonViewModel person in allPersons)
                                        {
                                            <SelectItem Value="person.Id">@person.Name</SelectItem>
                                        }
                                    }
                                    else
                                    {
                                        <SelectItem Value="(int?)null">Keine Personen verfügbar</SelectItem>
                                    }
                                </Select>
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Hauptdarsteller</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                @foreach (PersonViewModel person in selectedMovie.Actors)
                                {
                                    <Badge Color="Color.Primary"
                                            Margin="Margin.Is1.FromEnd.Is1.FromBottom"
                                            Padding="Padding.Is2"
                                            TextWeight="TextWeight.Normal"
                                            TextSize="TextSize.Small"
                                            CloseClicked="() => OnRemoveActor(person)">
                                        @person.Name
                                    </Badge>
                                }
                                <Select TValue="int?" @bind-SelectedValue="addActor">
                                    @if (availableActors?.Any() ?? false)
                                    {
                                        <SelectItem Value="(int?)null">Darsteller hinzufügen...</SelectItem>
                                        @foreach (PersonViewModel person in availableActors)
                                        {
                                            <SelectItem Value="@person.Id">@person.Name</SelectItem>
                                        }
                                    }
                                    else
                                    {
                                        <SelectItem Value="(int?)null">Keine Personen verfügbar</SelectItem>
                                    }
                                </Select>
                            </FieldBody>
                        </Field>
                        <Field Horizontal>
                            <FieldLabel ColumnSize="ColumnSize.Is4">Laufzeit</FieldLabel>
                            <FieldBody ColumnSize="ColumnSize.Is8">
                                <NumericEdit TValue="int?" Min="1" Max="1000" @bind-Value="selectedMovie.Duration" />
                                <FieldHelp>Minuten (1 - 1000)</FieldHelp>
                            </FieldBody>
                        </Field>
                    </Validations>
                }
            }
        </ModalBody>
        <ModalFooter>
            @if (movieModalMode == MovieModalMode.View)
            {
                <Button Color="Color.Primary" Clicked='() => NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("id", (int?)null))'>Schließen</Button>
            }
            else
            {
                <Button Color="Color.Secondary" Clicked="AbortMovieModal">Abbrechen</Button>
                <Button Color="Color.Primary" Clicked="SaveMovieAsync">Speichern</Button>
            }
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="relatedMoviesModal" Closing="OnRelatedMovieModalClosing">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>
                @switch (relationType)
                {
                    case RelationType.Genre:
                        <text>Filme im Genre <strong>@personOrGenreName</strong></text>
                        break;
                    case RelationType.Director:
                        <text>Filme, in denen <strong>@personOrGenreName</strong> als Regisseur agiert</text>
                        break;
                    case RelationType.Writer:
                        <text>Filme, die von <strong>@personOrGenreName</strong> geschrieben wurden</text>
                        break;
                    case RelationType.Actor:
                        <text>Filme, in denen <strong>@personOrGenreName</strong> als Hauptdarsteller agiert</text>
                        break;
                }
            </ModalTitle>
        </ModalHeader>
        <ModalBody>
            <ListGroup>
                @foreach (MovieViewModel movie in relatedMovies ?? [])
                {
                    <ListGroupItem>
                        @movie.Title
                    </ListGroupItem>
                }
            </ListGroup>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary" Clicked="CloseRelatedMoviesModalAsync">Schließen</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Warning @ref="discardWarning"
         WarningTitle="Änderungen verwerfen?"
         ConfirmButtonText="Änderungen verwerfen">
    <Text>Möchten Sie die Änderungen wirklich verwerfen?</Text>
</Warning>

<Warning @ref="deleteWarning"
         WarningTitle="Film löschen?"
         ConfirmButtonText="Film löschen">
    <Text>Möchten Sie den Film <strong>@deletingMovie</strong> wirklich löschen?</Text>
</Warning>

@code
{
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }
    private string? previousSearch;
    [SupplyParameterFromQuery(Name = "id")]
    public int? Id { get; set; }
    private int? previousId;

    private List<MovieViewModel>? allMovies;
    private List<PersonViewModel>? allPersons;
    private List<GenreViewModel>? allGenres;

    #region Lifecycle

    // protected override async Task OnInitializedAsync()
    // {
    //     // allGenres = (await GenreService.GetGenresAsync()).ToList();
    //     // allPersons = (await PersonService.GetPersonsAsync()).ToList();
    // }

    private bool rendered = false;
    private bool firstProcessParameters = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("FirstRender");
            rendered = true;
            await ProcessParameters();
            allGenres = (await GenreService.GetGenresAsync()).ToList();
            allPersons = (await PersonService.GetPersonsAsync()).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await ProcessParameters();
    }

    private async Task ProcessParameters()
    {
        if (rendered)
        {
            Console.WriteLine("ProcessParameters: " + firstProcessParameters);
            if (previousId != Id || firstProcessParameters)
            {
                if (Id is not null)
                {
                    await ShowMovieModalAsync(Id.Value);
                }
                else
                {
                    await CloseMovieModalAsync();
                }
            }

            if (previousSearch != SearchQuery || firstProcessParameters)
            {
                if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    allMovies = (await MovieService.GetMoviesAsync(SearchQuery)).ToList();
                }
                else
                {
                    allMovies = (await MovieService.GetMoviesAsync()).ToList();
                }

                StateHasChanged();
            }

            previousSearch = SearchQuery;
            previousId = Id;
            firstProcessParameters = false;
        }
    }

    #endregion

    #region Search Functionality

    private string searchText = string.Empty;

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task PerformSearch()
    {
        var escaped = searchText == string.Empty ? null : Uri.EscapeDataString(searchText);

        if (escaped != SearchQuery)
        {
            NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("search", escaped));
        }
    }

    #endregion

    #region Occuring Movies Modal

    private Modal relatedMoviesModal = null!;
    private IEnumerable<MovieViewModel>? relatedMovies;
    private string personOrGenreName = string.Empty;
    private RelationType relationType;
    private enum RelationType
    {
        Genre,
        Director,
        Writer,
        Actor
    }

    private async Task ShowRelatedMoviesModalAsync(int id, string name, RelationType type)
    {
        relationType = type;
        personOrGenreName = name;
        switch (type)
        {
            case RelationType.Genre:
                relatedMovies = await GenreService.GetMoviesAsync(id);
                break;
            case RelationType.Director:
                relatedMovies = await PersonService.GetDirectedMoviesAsync(id);
                break;
            case RelationType.Writer:
                relatedMovies = await PersonService.GetWrittenMoviesAsync(id);
                break;
            case RelationType.Actor:
                relatedMovies = await PersonService.GetActedInMoviesAsync(id);
                break;
        }
        await relatedMoviesModal.Show();
    }

    private Task OnRelatedMovieModalClosing(ModalClosingEventArgs e)
    {
        relatedMovies = null;
        personOrGenreName = string.Empty;
        return Task.CompletedTask;
    }

    private async Task CloseRelatedMoviesModalAsync()
    {
        await relatedMoviesModal.Hide();
    }

    #endregion

    #region Movie Modal

    private Modal movieModal = null!;
    private Validations? validations;
    private MovieModalMode movieModalMode;
    private bool cancelClose;
    private MovieDetailViewModel? selectedMovie;
    private List<GenreViewModel>? availableGenres;
    private List<PersonViewModel>? availableDirectors;
    private List<PersonViewModel>? availableActors;

    private enum MovieModalMode
    {
        View,
        Create,
        Edit
    }

    private int ratingValue
    {
        get => selectedMovie?.Rating ?? 0;
        set => selectedMovie!.Rating = value > 0 ? value : null;
    }

    private int? addGenre
    {
        get => null;
        set
        {
            var genre = availableGenres?.Find(g => g.Id == value);
            if (genre is not null)
            {
                availableGenres?.Remove(genre);
                selectedMovie?.Genres.Add(genre);
                addGenre = null;
            }
        }
    }

    private int? selectWriter
    {
        get => selectedMovie?.Writer?.Id;
        set
        {
            var person = allPersons?.Find(p => p.Id == value);
            selectedMovie!.Writer = person;
        }
    }

    private int? addDirector
    {
        get => null;
        set
        {
            var person = availableDirectors?.Find(g => g.Id == value);
            if (person is not null)
            {
                availableDirectors?.Remove(person);
                selectedMovie?.Directors.Add(person);
                addGenre = null;
            }
        }
    }

    private int? addActor
    {
        get => null;
        set
        {
            var person = availableActors?.Find(g => g.Id == value);
            if (person is not null)
            {
                availableActors?.Remove(person);
                selectedMovie?.Actors.Add(person);
                addGenre = null;
            }
        }
    }

    private void OnRemoveGenre(GenreViewModel genre)
    {
        selectedMovie?.Genres.Remove(genre);
        availableGenres?.Add(genre);
    }

    private void OnRemoveDirector(PersonViewModel person)
    {
        selectedMovie?.Directors.Remove(person);
        availableDirectors?.Add(person);
    }

    private void OnRemoveActor(PersonViewModel person)
    {
        selectedMovie?.Actors.Remove(person);
        availableActors?.Add(person);
    }

    private void UpdateAvailableSelections()
    {
        availableGenres = allGenres?.Where(g => !selectedMovie?.Genres.Any(g1 => g1.Id == g.Id) ?? true).ToList();
        availableDirectors = allPersons?.Where(p => !selectedMovie?.Directors.Any(p1 => p1.Id == p.Id) ?? true).ToList();
        availableActors = allPersons?.Where(p => !selectedMovie?.Actors.Any(p1 => p1.Id == p.Id) ?? true).ToList();
    }

    private async Task CreateMovieAsync()
    {
        selectedMovie = new MovieDetailViewModel();
        UpdateAvailableSelections();
        movieModalMode = MovieModalMode.Create;
        cancelClose = true;
        await movieModal.Show();
    }

    private async Task EditMovieAsync()
    {
        UpdateAvailableSelections();
        movieModalMode = MovieModalMode.Edit;
    }

    private async Task ShowMovieModalAsync(int id)
    {
        selectedMovie = await MovieService.GetMovieDetailAsync(id);
        movieModalMode = MovieModalMode.View;
        cancelClose = true;
        await movieModal.Show();
    }

    private async Task CloseMovieModalAsync()
    {
        cancelClose = false;
        await movieModal.Hide();
        selectedMovie = null;
    }

    private Task OnMovieModalOpening(ModalOpeningEventArgs e)
    {
        e.Cancel = selectedMovie is null;
        return Task.CompletedTask;
    }

    private Task OnMovieModalClosing(ModalClosingEventArgs e)
    {
        e.Cancel = cancelClose;
        return Task.CompletedTask;
    }

    private async Task SaveMovieAsync()
    {
        if (selectedMovie is not null && (validations?.AllValidationsSuccessful ?? false))
        {
            if (movieModalMode == MovieModalMode.Create)
            {
                var newMovie = await MovieService.CreateMovieAsync(selectedMovie);
                if (newMovie is not null)
                {
                    allMovies?.Add(newMovie);
                    StateHasChanged();
                    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("id", newMovie.Id));
                }
            }
            else if (movieModalMode == MovieModalMode.Edit)
            {
                if (await MovieService.UpdateMovieAsync(selectedMovie))
                {
                    allMovies?.Find(m => m.Id == selectedMovie.Id)?.Title = selectedMovie.Title;
                    StateHasChanged();
                }
                movieModalMode = MovieModalMode.View;
            }
        }
    }

    private async Task HandleAbortMovieModalAsync()
    {
        if (selectedMovie is not null && movieModalMode == MovieModalMode.Edit)
        {
            selectedMovie = await MovieService.GetMovieDetailAsync(selectedMovie.Id);
            movieModalMode = MovieModalMode.View;
            StateHasChanged();
        }
        else
        {
            await CloseMovieModalAsync();
        }
    }

    #endregion

    #region Delete Warning

    private Warning deleteWarning = null!;
    private string deletingMovie = string.Empty;

    private Task DeleteMovie(MovieViewModel movie)
    {
        deletingMovie = movie.Title;
        deleteWarning.Show(async () =>
        {
            if (await MovieService.DeleteMovieAsync(movie.Id))
            {
                allMovies?.Remove(movie);
                StateHasChanged();
            }
        });
        return Task.CompletedTask;
    }

    #endregion

    #region Discard Warning

    private Warning discardWarning = null!;

    private Task AbortMovieModal()
    {
        discardWarning.Show(HandleAbortMovieModalAsync);
        return Task.CompletedTask;
    }

    #endregion
}