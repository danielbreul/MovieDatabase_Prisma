<Modal>
    <ModalContent>
        <ModalHeader>
            <ModalTitle>
                @if (editMovie)
                {
                    @:(Film bearbeiten)
                }
                else
                {
                    @:(Filmdetails)
                }
            </ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Text>Titel: @Movie.Title</Text>
        </ModalBody>
        <ModalFooter>
            @if (editMovie)
            {
                <Button Color="Color.Secondary">Abbrechen</Button>
                <Button Color="Color.Primary">Speichern</Button>
            }
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [Parameter] public required ViewModels.MovieDetailViewModel Movie { get; set; }
    [Parameter] public required EventCallback OnCancel { get; set; }
    [Parameter] public required EventCallback OnConfirm { get; set; }

    private bool editMovie;
}
