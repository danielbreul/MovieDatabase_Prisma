@inherits LayoutComponentBase

<Blazorise.ThemeProvider Theme="@theme">
    <Layout>
        <LayoutHeader Fixed>
            <Bar Background="Background.Primary"
                 ThemeContrast="ThemeContrast.Dark"
                 Mode="BarMode.Horizontal"
                 Breakpoint="Breakpoint.Desktop">
                <BarBrand Margin="Margin.Is4.OnX">
                    <BarLink href="movies">Film Datenbank</BarLink>
                </BarBrand>
                <BarToggler />
                <BarMenu>
                    <BarStart>
                        <BarItem>
                            <BarLink href="movies" Match="Match.Prefix">Movies</BarLink>
                        </BarItem>
                        <BarItem>
                            <BarLink href="genres" Match="Match.Prefix">Genres</BarLink>
                        </BarItem>
                        <BarItem>
                            <BarLink href="persons" Match="Match.Prefix">Persons</BarLink>
                        </BarItem>
                    </BarStart>
                </BarMenu>
            </Bar>
        </LayoutHeader>
        <LayoutContent Margin="Margin.Is4.OnAll">
            <Error />
            @Body
        </LayoutContent>
    </Layout>
</Blazorise.ThemeProvider>

@code {
    private Theme theme = new Theme
    {
        BackgroundOptions = new ThemeBackgroundOptions
        {
            Primary = "#1B263B"
        },
        ColorOptions = new ThemeColorOptions
        {
            Primary = "#1B263B"
        }
    };
}