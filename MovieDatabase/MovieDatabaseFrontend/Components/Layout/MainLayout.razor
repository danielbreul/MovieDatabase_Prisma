﻿@inherits LayoutComponentBase

<Blazorise.ThemeProvider Theme="@theme">
    <Layout>
        <LayoutHeader Fixed>
            <Bar Background="Background.Primary" ThemeContrast="ThemeContrast.Dark" Mode="BarMode.Horizontal" Breakpoint="Breakpoint.Desktop">
                <BarBrand Margin="Margin.Is4.OnX">
                    <BarLink href="">Film Datenbank</BarLink>
                </BarBrand>
                <BarToggler />
                <BarMenu>
                    <BarStart>
                        <BarItem>
                            <BarLink href="" Match="Match.All">Movies</BarLink>
                        </BarItem>
                        <BarItem>
                            <BarLink href="genres" Match="Match.Prefix">Genres</BarLink>
                        </BarItem>
                        <BarItem>
                            <BarLink href="persons" Match="Match.Prefix">Persons</BarLink>
                        </BarItem>
                    </BarStart>
                </BarMenu>
            </Bar>
        </LayoutHeader>
        <LayoutContent Margin="Margin.Is4.OnAll">
            @Body
            <Error />
        </LayoutContent>
    </Layout>
</Blazorise.ThemeProvider>

@code{
    private Theme theme = new Theme
    {
        BackgroundOptions = new ThemeBackgroundOptions
        {
            Primary = "#1B263B"
        }
    };
}